---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Meet Our GMC-Registered Examining Doctors | Just Taxi Medicals";
const pageDescription = "Meet the GMC-registered medical doctors conducting driver medical assessments at Just Taxi Medicals UK: Dr Ayyaz Sultan (GMC #6049394) and Dr Ali Hassan Cheema (GMC #8022686).";

const breadcrumbs = [
  { name: "Our Doctors", url: "/our-doctors" }
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  
  <section style="background:linear-gradient(135deg, #16234F 0%, #0F3560 100%); color:#fff; padding:50px 20px 60px; border-bottom:4px solid #F5A623;">
    <div style="max-width:1100px; margin:0 auto;">
      <div style="font-size:13.5px; font-weight:700; color:#CFDEEF; margin-bottom:12px;">
        <a href="/" style="color:#CFDEEF; text-decoration:none;">Home</a> &nbsp;/&nbsp; <span style="color:#F5A623;">Our Medical Doctors</span>
      </div>

      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(245,166,35,0.15); border:1px solid #F5A623; color:#F5A623; padding:5px 12px; border-radius:16px; font-size:13px; font-weight:700; margin-bottom:14px;">
        <span>🩺</span> Clinical Governance & Trust
      </div>
      <h1 style="font-size:clamp(30px, 2.8vw + 16px, 44px); font-weight:800; line-height:1.2; margin:0 0 16px; color:#fff;">
        Meet Our GMC-Registered Examining Physicians
      </h1>
      <p style="font-size:17.5px; line-height:1.6; color:#CFDEEF; margin:0; max-width:680px;">
        Every driver medical examination is conducted by an approved medical practitioner with full GMC registration and an active licence to practise in the United Kingdom.
      </p>
    </div>
  </section>

  <!-- YMYL REFERENCE -->
  <section style="max-width:1100px; margin:30px auto 0; padding:0 20px;">
    <div class="clinical-factcheck-box">
      <div class="clinical-factcheck-icon">🛡️</div>
      <div class="clinical-factcheck-content">
        <strong>General Medical Council Verification Notice:</strong>
        In accordance with UK medical standards, all doctors examining vocational drivers at our clinics hold active registration with the 
        <a href="https://www.gmc-uk.org/registration-and-licensing/the-medical-register" target="_blank" rel="noopener">General Medical Council (GMC)</a>. 
        You can independently verify their credentials and registration status on the official public GMC register links provided below.
      </div>
    </div>
  </section>

  <!-- DOCTOR PROFILES -->
  <section style="max-width:1100px; margin:40px auto; padding:0 20px;">
    <div style="display:flex; flex-direction:column; gap:32px;">
      
      <!-- DR SULTAN -->
      <div style="background:#fff; border:1px solid #DFE3E9; border-top:5px solid #1C5FA8; border-radius:8px; padding:32px; box-shadow:0 4px 16px rgba(0,0,0,0.06);">
        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:18px;">
          <div>
            <h2 style="font-size:26px; font-weight:800; color:#16234F; margin:0 0 4px;">Dr Ayyaz Sultan</h2>
            <div style="font-size:16px; font-weight:700; color:#1C5FA8;">Consultant Cardiologist & Clinical Director</div>
            <div style="font-size:14px; color:#6B7280; margin-top:2px;">MBBS · MRCP (UK) · FRCP (Glasg) · FACC · FAHA</div>
          </div>
          <a href="https://www.gmc-uk.org/doctor/6049394" target="_blank" rel="noopener" style="background:#E8F5E9; color:#2E7D32; border:1px solid #A5D6A7; padding:8px 16px; border-radius:24px; font-size:14.5px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
            <span>🛡️</span> GMC Register: 6049394 ↗
          </a>
        </div>

        <p style="font-size:15.5px; color:#3E4453; line-height:1.7; margin:0 0 16px;">
          Dr Ayyaz Sultan is a distinguished Consultant Cardiologist with extensive clinical experience across the NHS and private medical practice. He holds fellowships with the Royal College of Physicians and Surgeons of Glasgow (FRCP), the American College of Cardiology (FACC), and the American Heart Association (FAHA).
        </p>

        <p style="font-size:15.5px; color:#3E4453; line-height:1.7; margin:0 0 20px;">
          As Medical Director at First Medical Consultants, Dr Sultan oversees clinical governance for all vocational driver medical assessments. His specialist expertise includes cardiovascular risk stratification in commercial drivers, ECG evaluation, resting blood pressure optimization, and compliance with the Secretary of State for Transport's Group 2 medical advisory standards.
        </p>

        <div style="background:#F5F7F9; border:1px solid #DFE3E9; border-radius:6px; padding:16px; font-size:14px;">
          <strong>Approved Services:</strong> Taxi Driver Medicals, D4 HGV / LGV Assessments, PCV Bus Medicals, C1 Ambulance Driver Assessments, Cardiology Consultations.
        </div>
      </div>

      <!-- DR CHEEMA -->
      <div style="background:#fff; border:1px solid #DFE3E9; border-top:5px solid #1C5FA8; border-radius:8px; padding:32px; box-shadow:0 4px 16px rgba(0,0,0,0.06);">
        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:18px;">
          <div>
            <h2 style="font-size:26px; font-weight:800; color:#16234F; margin:0 0 4px;">Dr Ali Hassan Cheema</h2>
            <div style="font-size:16px; font-weight:700; color:#1C5FA8;">Occupational Medical Examiner</div>
            <div style="font-size:14px; color:#6B7280; margin-top:2px;">MBBS · PLAB (GMC Registered 2024)</div>
          </div>
          <a href="https://www.gmc-uk.org/doctor/8022686" target="_blank" rel="noopener" style="background:#E8F5E9; color:#2E7D32; border:1px solid #A5D6A7; padding:8px 16px; border-radius:24px; font-size:14.5px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
            <span>🛡️</span> GMC Register: 8022686 ↗
          </a>
        </div>

        <p style="font-size:15.5px; color:#3E4453; line-height:1.7; margin:0 0 16px;">
          Dr Ali Hassan Cheema is a registered medical practitioner with clinical training in Emergency Medicine and Endocrinology. He conducts statutory DVLA Group 2 driver medical examinations across our regional clinic network.
        </p>

        <p style="font-size:15.5px; color:#3E4453; line-height:1.7; margin:0 0 20px;">
          Dr Cheema has detailed expertise in occupational driver screening, including Snellen visual acuity verification, peripheral visual field testing, diabetes glucose monitoring compliance (DVLA INF188/2 criteria), and blood pressure management. His practical, reassuring examination approach ensures drivers feel at ease throughout their appointment.
        </p>

        <div style="background:#F5F7F9; border:1px solid #DFE3E9; border-radius:6px; padding:16px; font-size:14px;">
          <strong>Approved Services:</strong> Wolverhampton Taxi Medicals, London TfL PCO Medicals, Manchester & Birmingham Taxi Medicals, D4 Driver Assessments.
        </div>
      </div>

    </div>
  </section>

  <!-- BOOKING CTA -->
  <section style="background:#16234F; color:#fff; padding:50px 20px; text-align:center;">
    <div style="max-width:800px; margin:0 auto;">
      <h2 style="font-size:30px; font-weight:800; color:#fff; margin:0 0 12px;">Book With Our Approved Doctors</h2>
      <p style="font-size:17px; color:#CFDEEF; margin:0 0 24px;">
        Fixed £60 all-inclusive fee. Pay on arrival by card or cash.
      </p>
      <button onclick="openBookingModal()" style="background:#F5A623; color:#16234F; font-size:16px; font-weight:800; padding:14px 32px; border-radius:4px; border:none; cursor:pointer; box-shadow:0 4px 12px rgba(245,166,35,0.3);">
        Book Appointment (£60)
      </button>
    </div>
  </section>

</Layout>
