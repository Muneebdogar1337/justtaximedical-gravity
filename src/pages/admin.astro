---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Clinic Administration & Dispatch Portal | Just Taxi Medicals";
const pageDescription = "Internal clinic management dashboard for managing driver appointments, updating booking statuses, and exporting appointment logs.";
---

<Layout title={pageTitle} description={pageDescription}>
  
  <section style="background:#16234F; color:#fff; padding:30px 20px; border-bottom:4px solid #F5A623;">
    <div style="max-width:1200px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:24px; font-weight:800; margin:0 0 4px; color:#fff;">
          Clinic Administration & Dispatch
        </h1>
        <div style="font-size:13.5px; color:#CFDEEF;">
          Just Taxi Medicals UK · Real-Time Appointment Ledger
        </div>
      </div>
      
      <div style="display:flex; gap:10px;">
        <button onclick="exportCSV()" style="background:#0F7A5A; color:#fff; font-size:14px; font-weight:700; padding:10px 18px; border-radius:4px; border:none; cursor:pointer; display:flex; align-items:center; gap:6px;">
          <span>📥</span> Export CSV
        </button>
        <button onclick="loadBookings()" style="background:#1C5FA8; color:#fff; font-size:14px; font-weight:700; padding:10px 18px; border-radius:4px; border:none; cursor:pointer;">
          🔄 Refresh
        </button>
      </div>
    </div>
  </section>

  <section style="max-width:1200px; margin:30px auto; padding:0 20px;">
    
    <!-- STATS CARDS -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:28px;">
      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:12.5px; font-weight:700; text-transform:uppercase; color:#6B7280;">Total Bookings</div>
        <div id="statTotal" style="font-size:32px; font-weight:900; color:#16234F; margin-top:4px;">0</div>
      </div>
      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:12.5px; font-weight:700; text-transform:uppercase; color:#6B7280;">Active / Confirmed</div>
        <div id="statConfirmed" style="font-size:32px; font-weight:900; color:#0F7A5A; margin-top:4px;">0</div>
      </div>
      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:12.5px; font-weight:700; text-transform:uppercase; color:#6B7280;">Pipeline Value</div>
        <div id="statValue" style="font-size:32px; font-weight:900; color:#1C5FA8; margin-top:4px;">£0</div>
      </div>
    </div>

    <!-- SEARCH & FILTER -->
    <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:16px; margin-bottom:20px; display:flex; gap:12px; flex-wrap:wrap;">
      <input type="text" id="searchInput" oninput="filterBookings()" placeholder="Search by driver name, phone, or REF code..." style="flex:1; min-width:260px; padding:10px 14px; border:1px solid #DFE3E9; border-radius:4px; font-size:14.5px; font-family:inherit;" />
    </div>

    <!-- BOOKINGS TABLE -->
    <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:14px; text-align:left;">
        <thead>
          <tr style="background:#F5F7F9; color:#16234F; border-bottom:2px solid #DFE3E9;">
            <th style="padding:12px 16px; font-weight:700;">Ref Code</th>
            <th style="padding:12px 16px; font-weight:700;">Driver Name</th>
            <th style="padding:12px 16px; font-weight:700;">Phone</th>
            <th style="padding:12px 16px; font-weight:700;">Service & Council</th>
            <th style="padding:12px 16px; font-weight:700;">Clinic Location</th>
            <th style="padding:12px 16px; font-weight:700;">Date & Time</th>
            <th style="padding:12px 16px; font-weight:700;">Status</th>
          </tr>
        </thead>
        <tbody id="bookingsTableBody">
          <tr>
            <td colspan="7" style="padding:24px; text-align:center; color:#6B7280;">Loading appointments...</td>
          </tr>
        </tbody>
      </table>
    </div>

  </section>

  <script is:inline>
    let allBookings = [];

    async function loadBookings() {
      try {
        const res = await fetch('/api/bookings');
        allBookings = await res.json();
        renderTable(allBookings);
        updateStats(allBookings);
      } catch (err) {
        document.getElementById('bookingsTableBody').innerHTML = '<tr><td colspan="7" style="padding:24px; text-align:center; color:#C62828;">Error loading bookings.</td></tr>';
      }
    }

    function renderTable(list) {
      const tbody = document.getElementById('bookingsTableBody');
      if (!list || list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="padding:24px; text-align:center; color:#6B7280;">No appointments found.</td></tr>';
        return;
      }

      tbody.innerHTML = list.map(b => `
        <tr style="border-bottom:1px solid #DFE3E9;">
          <td style="padding:12px 16px; font-weight:700; color:#1C5FA8;">${b.reference || 'REF'}</td>
          <td style="padding:12px 16px; font-weight:600; color:#16234F;">${b.name || b.client_name || 'Driver'}</td>
          <td style="padding:12px 16px;"><a href="tel:${b.phone || b.client_phone}" style="color:#0F7A5A; text-decoration:none; font-weight:600;">${b.phone || b.client_phone || '—'}</a></td>
          <td style="padding:12px 16px;">
            <div style="font-weight:600;">${b.service || 'Taxi Medical'}</div>
            <div style="font-size:12.5px; color:#6B7280;">${b.council || 'Council'}</div>
          </td>
          <td style="padding:12px 16px; color:#3E4453;">${b.clinic || 'Central'}</td>
          <td style="padding:12px 16px;">
            <div style="font-weight:600;">${b.date || b.appointment_date || 'TBD'}</div>
            <div style="font-size:12.5px; color:#6B7280;">${b.time || b.appointment_time || ''}</div>
          </td>
          <td style="padding:12px 16px;">
            <span style="background:#E8F5E9; color:#2E7D32; padding:4px 10px; border-radius:12px; font-size:12.5px; font-weight:700;">
              ${b.status || 'Confirmed'}
            </span>
          </td>
        </tr>
      `).join('');
    }

    function updateStats(list) {
      const total = list.length;
      const confirmed = list.filter(b => (b.status || '').toLowerCase() !== 'cancelled').length;
      document.getElementById('statTotal').innerText = total;
      document.getElementById('statConfirmed').innerText = confirmed;
      document.getElementById('statValue').innerText = '£' + (confirmed * 60).toLocaleString();
    }

    function filterBookings() {
      const q = (document.getElementById('searchInput').value || '').toLowerCase();
      const filtered = allBookings.filter(b => 
        (b.name || b.client_name || '').toLowerCase().includes(q) ||
        (b.reference || '').toLowerCase().includes(q) ||
        (b.phone || b.client_phone || '').toLowerCase().includes(q)
      );
      renderTable(filtered);
    }

    function exportCSV() {
      if (!allBookings || allBookings.length === 0) {
        alert('No bookings to export.');
        return;
      }
      const headers = ['Reference', 'Name', 'Phone', 'Service', 'Council', 'Clinic', 'Date', 'Time', 'Status'];
      const rows = allBookings.map(b => [
        b.reference || '',
        `"${b.name || b.client_name || ''}"`,
        `"${b.phone || b.client_phone || ''}"`,
        `"${b.service || ''}"`,
        `"${b.council || ''}"`,
        `"${b.clinic || ''}"`,
        b.date || b.appointment_date || '',
        b.time || b.appointment_time || '',
        b.status || 'Confirmed'
      ]);
      const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `just-taxi-medicals-bookings-${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Auto load on mount
    document.addEventListener('DOMContentLoaded', loadBookings);
  </script>

</Layout>
