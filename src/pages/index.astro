---
import Layout from '../layouts/Layout.astro';

const pageTitle = "UK Taxi Driver Medicals £60 | GMC Registered Doctors | DVLA Group 2";
const pageDescription = "Book your UK taxi or private hire driver medical examination for £60. Conducted by GMC-registered doctors for Wolverhampton, TfL, Birmingham, Manchester & all UK councils. Pay on arrival.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a UK taxi driver medical cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At Just Taxi Medicals, all taxi and private hire medical assessments cost £60 all-inclusive, with no hidden fees for vision testing or form stamping. You can pay on arrival at the clinic by cash or card."
      }
    },
    {
      "@type": "Question",
      "name": "Who conducts the medical examination?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All medical examinations are conducted by fully registered General Medical Council (GMC) doctors with an active licence to practise, including Dr Ayyaz Sultan (GMC #6049394) and Dr Ali Hassan Cheema (GMC #8022686)."
      }
    },
    {
      "@type": "Question",
      "name": "Will my local council accept a medical from your doctors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our doctors conduct examinations strictly in line with statutory DVLA Group 2 medical standards. Major licensing authorities including the City of Wolverhampton Council, Transport for London (TfL), Birmingham City Council, and Manchester City Council accept our completed certificates when accompanied by your NHS Summary Care Record (SCR)."
      }
    },
    {
      "@type": "Question",
      "name": "What are the eyesight requirements to pass a taxi medical?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under statutory DVLA Group 2 rules, you must achieve visual acuity of at least 6/7.5 on a Snellen chart in your better eye and at least 6/60 in the other eye (with glasses or contact lenses if worn). Your horizontal visual field must be at least 160 degrees."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my blood pressure is high on the day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To pass under Group 2 criteria, blood pressure must be consistently below 180/100 mmHg. If your initial reading is elevated due to white-coat syndrome or stress, our doctors will let you rest for 10 to 15 minutes and take up to three repeat readings."
      }
    }
  ]
};
