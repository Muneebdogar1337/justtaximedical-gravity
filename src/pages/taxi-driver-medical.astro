---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Taxi Driver Medical UK £60 | Hackney & Private Hire Assessments";
const pageDescription = "Book your UK taxi driver medical for £60. Approved DVLA Group 2 examination for private hire, Uber, Bolt, and Hackney carriage drivers. Pay on arrival.";

const breadcrumbs = [
  { name: "Taxi Medical", url: "/taxi-driver-medical" }
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  
  <section style="background:linear-gradient(135deg, #16234F 0%, #0F3560 100%); color:#fff; padding:50px 20px 60px; border-bottom:4px solid #F5A623;">
    <div style="max-width:1100px; margin:0 auto;">
      <div style="font-size:13.5px; font-weight:700; color:#CFDEEF; margin-bottom:12px;">
        <a href="/" style="color:#CFDEEF; text-decoration:none;">Home</a> &nbsp;/&nbsp; <span style="color:#F5A623;">Taxi Driver Medical</span>
      </div>

      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(245,166,35,0.15); border:1px solid #F5A623; color:#F5A623; padding:5px 12px; border-radius:16px; font-size:13px; font-weight:700; margin-bottom:14px;">
        <span>🚕</span> All UK Licensing Authorities
      </div>
      <h1 style="font-size:clamp(30px, 2.8vw + 16px, 44px); font-weight:800; line-height:1.2; margin:0 0 16px; color:#fff;">
        UK Taxi & Private Hire Driver Medicals <span style="color:#F5A623;">£60</span>
      </h1>
      <p style="font-size:17.5px; line-height:1.6; color:#CFDEEF; margin:0 0 20px; max-width:680px;">
        Official statutory Group 2 medical examinations conducted by GMC-registered physicians. Accepted by Wolverhampton, TfL, Birmingham, Manchester, Leeds, and all UK councils.
      </p>

      <div style="display:flex; flex-wrap:wrap; gap:14px;">
        <button onclick="openBookingModal('General UK Council', 'Taxi Medical (£60)')" style="background:#F5A623; color:#16234F; font-size:16px; font-weight:800; padding:14px 28px; border-radius:4px; border:none; cursor:pointer; box-shadow:0 4px 12px rgba(245,166,35,0.35);">
          Book Taxi Medical — £60
        </button>
        <a href="tel:03300589690" style="background:rgba(255,255,255,0.12); color:#fff; text-decoration:none; font-size:15.5px; font-weight:700; padding:14px 22px; border-radius:4px; border:1px solid rgba(255,255,255,0.2); display:inline-flex; align-items:center; gap:8px;">
          <span>📞</span> 0330 058 9690
        </a>
      </div>
    </div>
  </section>

  <!-- YMYL REFERENCE -->
  <section style="max-width:1100px; margin:30px auto 0; padding:0 20px;">
    <div class="clinical-factcheck-box">
      <div class="clinical-factcheck-icon">🛡️</div>
      <div class="clinical-factcheck-content">
        <strong>Statutory Authority Notice:</strong>
        Taxi driver licensing is governed under the <em>Local Government (Miscellaneous Provisions) Act 1976</em> and Section 57 medical assessment guidelines. All clinical fitness determinations comply with official 
        <a href="https://www.gov.uk/guidance/assessing-fitness-to-drive-a-guide-for-medical-professionals" target="_blank" rel="noopener">DVLA Group 2 Medical Standards</a>.
      </div>
    </div>
  </section>

  <!-- CONTENT BLOCKS -->
  <section style="max-width:1100px; margin:40px auto; padding:0 20px;">
    <h2 style="font-size:28px; font-weight:800; color:#16234F; margin:0 0 16px;">Everything Included in Your Appointment</h2>
    
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px;">
      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:20px; margin-bottom:8px;">👁️ Snellen Eye Test</div>
        <p style="font-size:14.5px; color:#3E4453; margin:0; line-height:1.5;">
          Complete vision screening reaching 6/7.5 and 6/60 benchmarks with 160° peripheral visual field confirmation.
        </p>
      </div>

      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:20px; margin-bottom:8px;">🩺 Blood Pressure Check</div>
        <p style="font-size:14.5px; color:#3E4453; margin:0; line-height:1.5;">
          Accurate blood pressure measurement below 180/100 mmHg with free rest re-test if you feel anxious.
        </p>
      </div>

      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:20px; margin-bottom:8px;">📋 Summary Care Record Review</div>
        <p style="font-size:14.5px; color:#3E4453; margin:0; line-height:1.5;">
          Full scrutiny of your NHS GP medical summary to confirm cardiovascular, endocrine, and neurological suitability.
        </p>
      </div>

      <div style="background:#fff; border:1px solid #DFE3E9; border-radius:6px; padding:20px;">
        <div style="font-size:20px; margin-bottom:8px;">✍️ Official Council Signing & Stamp</div>
        <p style="font-size:14.5px; color:#3E4453; margin:0; line-height:1.5;">
          Doctor signs your council medical certificate, records their GMC registration number, and applies clinic stamp.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#16234F; color:#fff; padding:50px 20px; text-align:center;">
    <div style="max-width:800px; margin:0 auto;">
      <h2 style="font-size:28px; font-weight:800; color:#fff; margin:0 0 12px;">Book Your Taxi Medical Today</h2>
      <p style="font-size:16.5px; color:#CFDEEF; margin:0 0 20px;">
        Fixed £60 all-inclusive fee. Pay on arrival by card or cash.
      </p>
      <button onclick="openBookingModal('General UK Council', 'Taxi Medical (£60)')" style="background:#F5A623; color:#16234F; font-size:16px; font-weight:800; padding:14px 32px; border-radius:4px; border:none; cursor:pointer; box-shadow:0 4px 12px rgba(245,166,35,0.3);">
        Book Appointment (£60)
      </button>
    </div>
  </section>

</Layout>
