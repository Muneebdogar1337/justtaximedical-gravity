      </a>
      <a href="https://wa.me/443300589690?text=Hi%2C%20I%20need%20a%20taxi%20medical%20appointment" target="_blank" rel="noopener" class="sticky-bar-btn sticky-bar-whatsapp">
        <span>💬</span> WhatsApp
      </a>
      <button onclick="openBookingModal()" class="sticky-bar-btn sticky-bar-book" style="border:none; cursor:pointer;">
        <span>📅</span> Book (£60)
      </button>
    </div>

    <!-- Booking Modal Dialog -->
    <div id="bookingModal" style="display:none; position:fixed; inset:0; background:rgba(15,53,96,0.7); backdrop-filter:blur(3px); z-index:10000; align-items:center; justify-content:center; padding:16px;">
      <div style="background:#fff; border-radius:8px; max-width:540px; width:100%; max-height:90vh; overflow-y:auto; box-shadow:0 12px 36px rgba(0,0,0,0.25); position:relative; padding:28px;">
        
        <button onclick="closeBookingModal()" style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:24px; cursor:pointer; color:#6B7280;">✕</button>

        <div style="text-align:center; margin-bottom:20px;">
          <div style="font-size:22px; font-weight:800; color:#16234F;">Book Your Driver Medical</div>
          <div style="font-size:14px; color:#0F7A5A; font-weight:700; margin-top:4px;">
            ✓ £60 Fixed Price · GMC Registered Doctor · Pay on Arrival Available
          </div>
        </div>

        <form id="bookingForm" onsubmit="submitBooking(event)" style="display:flex; flex-direction:column; gap:16px;">
          <div>
            <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Medical Examination Type</label>
            <select id="serviceSelect" style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;">
              <option value="Taxi Medical (£60)">Taxi & Private Hire Medical (£60)</option>
              <option value="D4 HGV Medical (£60)">D4 HGV / Lorry Driver Medical (£60)</option>
              <option value="PCV Bus Medical (£60)">PCV Bus & Coach Medical (£60)</option>
              <option value="Ambulance C1 Medical (£60)">Ambulance / Paramedic C1 Medical (£60)</option>
            </select>
          </div>

          <div>
            <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Licensing Authority / Council</label>
            <select id="councilSelect" style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;">
              <option value="Wolverhampton Council">City of Wolverhampton Council</option>
              <option value="Transport for London (TfL)">Transport for London (TfL PCO)</option>
              <option value="Birmingham City Council">Birmingham City Council</option>
              <option value="Manchester City Council">Manchester City Council</option>
              <option value="Leeds City Council">Leeds City Council</option>
              <option value="Liverpool City Council">Liverpool City Council</option>
              <option value="Sheffield City Council">Sheffield City Council</option>
              <option value="Bradford Council">Bradford Council</option>
              <option value="DVLA Standard D4">DVLA Standard D4 (HGV / Bus)</option>
              <option value="Other UK Council">Other UK Council</option>
            </select>
          </div>

          <div>
            <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Preferred Examination Clinic</label>
            <select id="clinicSelect" style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;">
              <option value="Manchester City Centre (Piccadilly)">Manchester City Centre (Piccadilly)</option>
              <option value="Liverpool Central Clinic">Liverpool Central Clinic</option>
              <option value="Birmingham Central Clinic">Birmingham Central Clinic</option>
              <option value="Leeds City Centre Clinic">Leeds City Centre Clinic</option>
              <option value="London Central Clinic">London Central Clinic</option>
              <option value="Wolverhampton Regional Clinic">Wolverhampton Regional Clinic</option>
            </select>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div>
              <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Preferred Date</label>
              <input type="date" id="dateInput" required style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;" />
            </div>
            <div>
              <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Time Slot</label>
              <select id="timeSelect" style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;">
                <option value="Morning (09:00 - 12:00)">Morning (09:00 - 12:00)</option>
                <option value="Afternoon (12:00 - 16:00)">Afternoon (12:00 - 16:00)</option>
                <option value="Late Afternoon (16:00 - 18:30)">Late Afternoon (16:00 - 18:30)</option>
              </select>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div>
              <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Full Name</label>
              <input type="text" id="nameInput" placeholder="Driver Full Name" required style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;" />
            </div>
            <div>
              <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">UK Mobile Number</label>
              <input type="tel" id="phoneInput" placeholder="07123 456789" required style="width:100%; padding:10px 12px; border:1px solid #DFE3E9; border-radius:4px; font-size:15px; font-family:inherit;" />
            </div>
          </div>

          <div>
            <label style="display:block; font-size:13.5px; font-weight:700; color:#16234F; margin-bottom:4px;">Payment Option</label>
            <div style="display:flex; gap:12px;">
              <label style="display:flex; align-items:center; gap:6px; font-size:14.5px; font-weight:600; cursor:pointer;">
                <input type="radio" name="paymentOption" value="arrival" checked />
                Pay on Arrival (£60 Cash / Card)
              </label>
            </div>
          </div>

          <button type="submit" id="submitBtn" style="background:#0F7A5A; color:#fff; font-weight:800; font-size:16px; padding:14px; border-radius:4px; border:none; cursor:pointer; margin-top:8px; box-shadow:0 3px 8px rgba(15,122,90,0.3);">
            Confirm Appointment Booking (£60)
          </button>
        </form>

        <div id="bookingResult" style="display:none; text-align:center; padding:20px 0;">
          <div style="font-size:48px; color:#0F7A5A; line-height:1; margin-bottom:12px;">✓</div>
          <div style="font-size:22px; font-weight:800; color:#16234F;">Appointment Reserved!</div>
          <p style="font-size:15px; color:#3E4453; margin:8px 0 16px;">
            Booking Reference: <strong id="resRef" style="color:#1C5FA8; font-size:18px;"></strong>
          </p>
          <div style="background:#EDF3FA; padding:16px; border-radius:6px; text-align:left; font-size:14px; color:#222530; margin-bottom:20px;">
            <strong>What to bring with you:</strong>
            <ul style="margin:6px 0 0; padding-left:20px;">
              <li>Your council medical form or DVLA D4 form</li>
              <li>Valid Photo ID (Driving Licence or Passport)</li>
              <li>Your driving glasses / contact lenses & prescription</li>
              <li>NHS Summary Care Record (SCR) if required by council</li>
            </ul>
          </div>
          <button onclick="closeBookingModal()" style="background:#1C5FA8; color:#fff; font-weight:700; font-size:14px; padding:10px 24px; border-radius:4px; border:none; cursor:pointer;">
            Done
          </button>
        </div>

      </div>
    </div>

    <!-- Interactive Scripts -->
    <script is:inline>
      function openBookingModal(councilName, serviceName) {
        const modal = document.getElementById('bookingModal');
        if (modal) {
          modal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
          if (councilName) {
            const councilEl = document.getElementById('councilSelect');
            if (councilEl) councilEl.value = councilName;
          }
          if (serviceName) {
            const serviceEl = document.getElementById('serviceSelect');
            if (serviceEl) serviceEl.value = serviceName;
          }
          // Set min date to tomorrow
          const dateInput = document.getElementById('dateInput');
          if (dateInput && !dateInput.value) {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            dateInput.min = tomorrow.toISOString().split('T')[0];
            dateInput.value = tomorrow.toISOString().split('T')[0];
          }
        }
      }

      function closeBookingModal() {
        const modal = document.getElementById('bookingModal');
        if (modal) {
          modal.style.display = 'none';
          document.body.style.overflow = '';
          document.getElementById('bookingForm').style.display = 'flex';
          document.getElementById('bookingResult').style.display = 'none';
        }
      }

      async function submitBooking(e) {
        e.preventDefault();
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.innerText = 'Reserving Slot...';

        const payload = {
          service: document.getElementById('serviceSelect').value,
          council: document.getElementById('councilSelect').value,
          clinic: document.getElementById('clinicSelect').value,
          date: document.getElementById('dateInput').value,
          time: document.getElementById('timeSelect').value,
          name: document.getElementById('nameInput').value,
          phone: document.getElementById('phoneInput').value,
          payment: 'Pay on Arrival (£60)'
        };

        try {
          const res = await fetch('/api/bookings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          document.getElementById('resRef').innerText = data.reference || ('JTM-' + Math.floor(10000 + Math.random() * 90000));
          document.getElementById('bookingForm').style.display = 'none';
          document.getElementById('bookingResult').style.display = 'block';
        } catch (err) {
          // Fallback if offline
          document.getElementById('resRef').innerText = 'JTM-' + Math.floor(10000 + Math.random() * 90000);
          document.getElementById('bookingForm').style.display = 'none';
          document.getElementById('bookingResult').style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Confirm Appointment Booking (£60)';
        }
      }
    </script>
  </body>
</html>
