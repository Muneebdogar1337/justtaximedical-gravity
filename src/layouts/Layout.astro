    <!-- Main Navigation Header -->
    <header style="background:#fff; border-bottom:1px solid #DFE3E9; position:sticky; top:0; z-index:100; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
      <div style="max-width:1200px; margin:0 auto; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; gap:20px;">
        
        <!-- Brand Logo -->
        <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:10px;">
          <div style="background:#1C5FA8; color:#fff; width:40px; height:40px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:20px;">
