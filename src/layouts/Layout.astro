---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  breadcrumbs?: BreadcrumbItem[];
  extraSchema?: object | object[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  breadcrumbs = [],
  extraSchema
} = Astro.props;

const siteUrl = 'https://justtaximedicals.co.uk';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;

// BreadcrumbList schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    ...breadcrumbs.map((b, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": b.name,
      "item": b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`
    }))
  ]
} : null;

// Base Organization Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  "@id": `${siteUrl}/#organization`,
  "name": "Just Taxi Medicals UK",
  "url": siteUrl,
  "logo": `${siteUrl}/assets/logo/logo.svg`,
  "telephone": "+443300589690",
  "email": "bookings@justtaximedicals.co.uk",
  "priceRange": "£60",
  "medicalSpecialty": "OccupationalMedicine",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Piccadilly House, 49 Piccadilly",
    "addressLocality": "Manchester",
    "postalCode": "M1 2AP",
    "addressCountry": "GB"
  },
  "founder": [
    {
      "@type": "Physician",
      "name": "Dr Ayyaz Sultan",
      "jobTitle": "Medical Director & Consultant Cardiologist",
      "identifier": "6049394",
      "sameAs": "https://www.gmc-uk.org/doctor/6049394",
      "alumniOf": "Royal College of Physicians and Surgeons of Glasgow"
    },
    {
      "@type": "Physician",
      "name": "Dr Ali Hassan Cheema",
      "jobTitle": "Occupational Medical Examiner",
      "identifier": "8022686",
      "sameAs": "https://www.gmc-uk.org/doctor/8022686"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "2840",
    "bestRating": "5"
  }
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Just Taxi Medicals UK</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Just Taxi Medicals UK`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Just Taxi Medicals UK" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Just Taxi Medicals UK`} />
    <meta name="twitter:description" content={description} />

    <!-- Styles -->
    <link rel="stylesheet" href="/styles.css" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {extraSchema && <script type="application/ld+json" set:html={JSON.stringify(extraSchema)} />}
  </head>

  <body>
    <!-- Top Regulatory & Trust Announcement Bar -->
